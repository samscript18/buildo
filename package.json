{
  "name": "buildo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:indexes": "node --conditions=react-server --import tsx --env-file=.env.local scripts/indexes.ts",
    "admin:grant": "tsx --env-file=.env.local scripts/admin.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:preflight": "node --env-file=.env.local scripts/live-preflight.mjs",
    "test:live-model": "node --env-file=.env.local scripts/live-model-browser.mjs",
    "generation:reconcile": "node --conditions=react-server --import tsx --env-file=.env.local scripts/reconcile-generation.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.23",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.23",
    "cloudinary": "^2.11.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.72.0",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
